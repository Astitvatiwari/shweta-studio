# PostgreSQL connection for the Node.js API. Use a managed database URL.
DATABASE_URL=
# Optional DDL-capable connection used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=
PGSSLMODE=require
STORAGE_BACKEND=postgres

# Backend runtime
NODE_ENV=production
PORT=10000
CHECKOUT_RESERVATION_TTL_MS=900000
API_RATE_LIMIT_PER_PROXY=600
ALLOW_DEMO_CHECKOUT=false
ADMIN_API_KEY=
NETLIFY_PROXY_SIGNING_SECRET=
STOREFRONT_ORIGINS=https://shwetastudio.com
NETLIFY_SITE_URL=

# Razorpay test credentials only for staging; never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
